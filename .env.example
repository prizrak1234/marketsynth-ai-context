# --- Application ---
APP_ENV=development
APP_NAME=botfazer
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Security ---
TELEGRAM_WEBHOOK_SECRET=change-me-in-production
PII_SANITIZER_ENABLED=true

# --- PostgreSQL (Phase 1) ---
DATABASE_URL=postgresql+asyncpg://botfazer:botfazer@localhost:5432/botfazer
DATABASE_ECHO=false
# CPH.1 — read-only revision diagnostic (never auto-migrates / never auto-stamps)
ALEMBIC_REVISION_CHECK_ENABLED=true
ALEMBIC_REVISION_FAIL_FAST=false

# CPH.3 — pilot browser sessions (HttpOnly cookie; do not put API keys in browser localStorage)
BROWSER_SESSION_TTL_HOURS=8
BROWSER_SESSION_COOKIE_NAME=ms_pilot_session
BROWSER_SESSION_COOKIE_SECURE=false
BROWSER_SESSION_COOKIE_SAMESITE=lax
BROWSER_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BROWSER_CSRF_ALLOW_MISSING_ORIGIN=false

# Pilot self-registration (member only). Unset = on for development/test, off for pilot/staging/production.
# PUBLIC_SIGNUP_ENABLED=true
# PUBLIC_SIGNUP_AUTO_APPROVE_BETA=true

# --- Redis (Phase 1) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers (Phase 2.3) ---
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-model
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Phase 2.10 — pass tool definitions to provider (execution remains no-op)
TOOLS_PROVIDER_ENABLED=false

# Phase 2.16+ — tool result size and multi-tool round limits
TOOL_RESULT_MAX_BYTES=24000
TOOL_RESULTS_TOTAL_MAX_BYTES=48000
MAX_TOOL_CALLS_PER_ROUND=5

# Phase AI.19 — session-scoped chat history (not long-term memory)
AGENT_CHAT_SESSION_HISTORY_LIMIT=10

# Phase 4.2 — agent write tools (disabled by default; draft-only create_draft)
AGENT_WRITE_TOOLS_ENABLED=false
AGENT_WRITE_TOOL_CONTENT_ASSET_CREATE_DRAFT_ENABLED=false
CONTENT_ASSET_REVISION_WRITE_TOOL_ENABLED=false
# Phase AI.7 — agent chat content revision (requires write + chat + tools provider + this flag)
CAMPAIGN_PLAN_DRAFT_WRITE_TOOL_ENABLED=false
# Phase AI.5 — chat generate assets from plan draft (orchestrator/content_planner only)
CAMPAIGN_PLAN_DRAFT_GENERATE_ASSETS_TOOL_ENABLED=false
# Phase AI.3 — agent chat plan draft tools (requires write + chat + tools provider flags)
AGENT_CHAT_TOOLS_ENABLED=false
AGENT_WRITE_TOOL_BODY_MAX_CHARS=12000
CONTENT_ASSET_ROLLBACK_FROM_ARCHIVED_ENABLED=false

# Phase 3.0 — agent execution engine (classic default; langgraph for graph dry-run endpoint)
AGENT_EXECUTION_ENGINE=classic
AGENT_EXECUTION_ENGINE_REQUEST_OVERRIDE_ENABLED=false
AGENT_EXECUTION_LANGGRAPH_ENABLED=true
AGENT_EXECUTION_FORCE_CLASSIC=false
GRAPH_VERSION=3.16
GRAPH_MAX_STEPS=16
GRAPH_CHECKPOINTS_ENABLED=true
GRAPH_MEMORY_ENABLED=true
GRAPH_MEMORY_LIMIT=5
GRAPH_HANDOFF_ENABLED=true
GRAPH_HANDOFF_CHILD_RUN_ENABLED=true
GRAPH_HANDOFF_EXECUTE_CHILD=false
GRAPH_HANDOFF_MAX_DEPTH=2
GRAPH_HANDOFF_WORKER_ENABLED=true
GRAPH_HANDOFF_WORKER_BATCH_LIMIT=5
GRAPH_HANDOFF_QUEUE_ENABLED=true
GRAPH_HANDOFF_SCHEDULER_ENABLED=false
GRAPH_HANDOFF_SCHEDULER_INTERVAL_SECONDS=30
GRAPH_HANDOFF_SCHEDULER_OWNER_LIMIT=10
GRAPH_HANDOFF_MAX_ATTEMPTS=3
GRAPH_HANDOFF_DLQ_ENABLED=true
EVENT_OUTBOX_DISPATCHER_ENABLED=false
EVENT_OUTBOX_DISPATCHER_INTERVAL_SECONDS=30
EVENT_OUTBOX_DISPATCH_BATCH_LIMIT=50
EVENT_OUTBOX_DISPATCH_MAX_ATTEMPTS=5
EVENT_OUTBOX_WEBHOOK_TIMEOUT_SECONDS=10

# Phase 6.1 — publication worker (mock dispatcher only; disabled by default)
PUBLICATION_WORKER_ENABLED=false
PUBLICATION_WORKER_INTERVAL_SECONDS=30
PUBLICATION_JOB_MAX_ATTEMPTS=3
PUBLICATION_DELIVERY_TIMEOUT_SECONDS=10

OPENAI_API_KEY=

# Media generation (AI.56–AI.59) — off by default; mock does not need API keys
MEDIA_GENERATION_ENABLED=false
OPENAI_IMAGES_ENABLED=false
OPENAI_IMAGES_MODEL=gpt-image-1

# Phase H2.6A — UserRequest image generation
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_PROVIDER=mock
IMAGE_GENERATION_STORAGE_DIR=data/generated_visuals
ALLOW_MOCK_IMAGE_RESULTS=true
# For product gate: IMAGE_GENERATION_PROVIDER=openai_images + valid OPENAI_API_KEY
# Optional GPTunnel CreativeLab fallback (typo alias GPTunnel_API_REY also accepted)
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
GPTUNNEL_IMAGES_MODEL=gpt-image-1
# Video Studio VS.1 — stays false until owner paid smoke (see docs/VIDEO_STUDIO_PRODUCT.md)
VIDEO_GENERATION_ENABLED=false
GPTUNNEL_VIDEO_MODEL=glabs-veo-3-1-fast
# VS.2A VR.2A — bounded provider result download (streaming, temp file, atomic finalize)
VIDEO_CLIP_DOWNLOAD_MAX_BYTES=104857600
VIDEO_CLIP_DOWNLOAD_TIMEOUT_SECONDS=120
IMAGE_GENERATION_FALLBACK_PROVIDER=
# Mock never counts as a user-facing AI result.

# Phase H2.6A-R — reference uploads (up to 15; provider receives ranked subset)
REFERENCE_IMAGE_MAX_COUNT=15
REFERENCE_IMAGE_MAX_BYTES_PER_FILE=20971520
REFERENCE_IMAGE_MAX_TOTAL_BYTES=157286400
REFERENCE_IMAGE_MIN_WIDTH=256
REFERENCE_IMAGE_MIN_HEIGHT=256
REFERENCE_IMAGE_STORAGE_DIR=data/reference_visuals
REFERENCE_PROVIDER_MAX_IMAGES=10
# H2.8D — person identity: max identity refs considered (OpenAI edit still transmits primary only)
REFERENCE_IDENTITY_MAX_IMAGES=5
# H2.8D — gated A/B harness; paid calls also require owner_confirmed_paid_calls in the request
IDENTITY_AB_HARNESS_ENABLED=false

# Publishing — Telegram real send (AI.70–AI.75), off by default
# E2E demo status + provenance (default on in APP_ENV=development)
DEMO_FLOW_ENDPOINTS_ENABLED=false
# Beta admin dashboard (default on in APP_ENV=development)
BETA_ADMIN_ENDPOINTS_ENABLED=false
# Soft limits for testers (stricter in staging/production)
BETA_LIMITS_ENABLED=true
# Business Operator assist confidence gate (AI.188)
BUSINESS_OPERATOR_CONFIDENCE_THRESHOLD=0.65
# LLM fallback when rule confidence is low (AI.203) — off by default
BUSINESS_OPERATOR_LLM_FALLBACK_ENABLED=false
BUSINESS_OPERATOR_LLM_MIN_CONFIDENCE_TO_ACCEPT=0.65
# Campaign brief completeness gate before create (AI.208) — 100 = all required fields
CAMPAIGN_BRIEF_COMPLETENESS_THRESHOLD=100
# Marketing data tools — mock Wordstat/Metrica/image (AI.221); off in production by default
MARKETING_DATA_TOOLS_ENABLED=false
MARKETING_DATA_TOOLS_MOCK_ENABLED=true
# Marketing skills — professional processes over tools (AI.228)
MARKETING_SKILLS_ENABLED=false
MARKETING_SKILLS_MOCK_ENABLED=true

TELEGRAM_PUBLISHING_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLICATION_TIMEOUT_SECONDS=10
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
XAI_API_KEY=
N8N_BASE_URL=
N8N_API_KEY=
MAKE_API_KEY=
MAKE_ZONE=
MAKE_API_BASE_URL=
FIRECRAWL_API_KEY=
XMLRIVER_USER_ID=
XMLRIVER_API_KEY=
XMLRIVER_WORDSTAT_HTTPS=true
# Avito product skill — leave empty until owner provides credentials (installed_unconfigured)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
ABACUS_API_KEY=
# Alias for n8n/RouteLLM workflows (same value as ABACUS_API_KEY if set alone):
# ROUTELLM_API_KEY=
ABACUS_API_BASE_URL=https://routellm.abacus.ai/v1
PINECONE_API_KEY=

# --- Phase H2.7 content draft execution (draft-only, no publication) ---
CONTENT_DRAFT_EXECUTION_ENABLED=false
CONTENT_DIRECTOR_DETERMINISTIC=false
# Content Director Image Golden Path — fixture PNGs for tests/E2E only (never default-on for customers)
CONTENT_DIRECTOR_IMAGE_DETERMINISTIC=false
# H2.9A / KG.3 read-only source candidate collection
RESEARCH_SOURCE_COLLECTION_ENABLED=true
RESEARCH_SOURCE_COLLECTION_MOCK_PROVIDERS=false
# Multi-provider fetch contour (PRODUCT-01.3B)
RESEARCH_FETCH_PROVIDER_ORDER=firecrawl,jina,tavily,trafilatura,playwright
RESEARCH_FETCH_FALLBACK_ENABLED=true
RESEARCH_FETCH_MAX_PROVIDER_ATTEMPTS=5
RESEARCH_FETCH_TIMEOUT_SECONDS=30
RESEARCH_FETCH_MAX_CONTENT_BYTES=512000
RESEARCH_FETCH_CACHE_ENABLED=true
RESEARCH_FETCH_PLAYWRIGHT_ENABLED=false
JINA_API_KEY=
TAVILY_API_KEY=
TAVILY_EXTRACT_DEPTH=basic
# REAL-RESEARCH-READINESS budgets (search/fetch only — BIV pipeline has no LLM)
BIV_RESEARCH_MAX_SEARCH_CALLS=32
BIV_RESEARCH_MAX_FETCH_CALLS=40
BIV_RESEARCH_MAX_LATENCY_SECONDS=600
BIV_RESEARCH_MAX_ESTIMATED_COST_USD=5.0
# RUNTIME-01F — deterministic E2E fixture boundary (development/test only; never enable in production)
# Requires APP_ENV=development or test; ignored in pilot/staging/production even if true.
BIV_E2E_DETERMINISTIC_ENABLED=false
BIV_RUN_DISPATCHER_ENABLED=true
CONTENT_DRAFT_LLM_PROVIDER=mock
CONTENT_DRAFT_LLM_MODEL=mock-model

# --- KG.2 Knowledge Governance runtime enforcement ---
# When true, drilling/industrial/oil-gas content.telegram_post requires published+fresh governed Snapshot.
KNOWLEDGE_GOVERNANCE_RUNTIME_ENFORCED=true

# For owner product acceptance of content.telegram_post use a real text model, e.g.:
# CONTENT_DRAFT_EXECUTION_ENABLED=true
# CONTENT_DRAFT_LLM_PROVIDER=openai
# CONTENT_DRAFT_LLM_MODEL=gpt-4o-mini
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DIRECT_OAUTH_TOKEN=
YANDEX_METRICA_OAUTH_TOKEN=
YANDEX_AI_STUDIO_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Optional / future integrations (empty placeholders) ---
JWT_SECRET=
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CPH.5 pilot / production-like profile (placeholders only) ---
# APP_ENV=pilot
# DEBUG=false
# ALEMBIC_REVISION_CHECK_ENABLED=true
# ALEMBIC_REVISION_FAIL_FAST=true
# PILOT_REQUIRE_DATABASE_NAME=botfazer_cph1
# PILOT_BACKUP_MAX_AGE_HOURS=48
# PUBLIC_FRONTEND_URL=https://pilot.localhost
# PUBLIC_BACKEND_URL=https://pilot.example/api
# Temporary provider-fetch signed URLs for GPTunnel images[] (opaque, one-time, TTL<=10m)
# ASSET_SIGNED_URL_ENABLED=false
# ASSET_SIGNED_URL_TTL_SECONDS=600
# ASSET_SIGNED_URL_SECRET=
# BROWSER_ALLOWED_ORIGINS=["https://pilot.localhost"]
# BROWSER_SESSION_COOKIE_SECURE=true
# BROWSER_SESSION_COOKIE_SAMESITE=lax
# BROWSER_CSRF_ALLOW_MISSING_ORIGIN=false
# TOOLS_PROVIDER_ENABLED=false
# PUBLICATION_WORKER_ENABLED=false
# GRAPH_HANDOFF_EXECUTE_CHILD=false
# EVENT_OUTBOX_DISPATCHER_ENABLED=false
# DEMO_FLOW_ENDPOINTS_ENABLED=false
# MEDIA_GENERATION_ENABLED=false
# TELEGRAM_PUBLICATION_ENABLED=false

# Commercial Generation Reliability
GENERATION_RELIABILITY_ENABLED=true
GENERATION_RELIABILITY_REQUIRE_APPROVAL_ABOVE=60

# --- CONN-HF-01 Higgsfield MCP Media Renderer (executor only) ---
# Skills produce MediaRenderSpec; connector.higgsfield executes via MCP.
# HIGGSFIELD_MCP_ENABLED=false
# HIGGSFIELD_MCP_ENDPOINT=https://mcp.higgsfield.ai/mcp
# HIGGSFIELD_OAUTH_ACCESS_TOKEN=
# HIGGSFIELD_MCP_TIMEOUT_SECONDS=60
# HIGGSFIELD_VIDEO_RENDER_ENABLED=false
# HIGGSFIELD_MCP_TOOL_OVERRIDES_JSON={}

