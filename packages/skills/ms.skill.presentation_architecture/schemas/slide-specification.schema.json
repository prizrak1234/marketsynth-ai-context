{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slide-specification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slide_id": { "type": "string" },
    "sequence_number": { "type": "integer", "minimum": 1 },
    "slide_type": { "type": "string" },
    "title": { "type": "string" },
    "purpose": { "type": "string" },
    "key_message": { "type": "string" },
    "supporting_points": { "type": "array", "items": { "type": "string" } },
    "evidence_references": { "type": "array", "items": { "type": "object" } },
    "claim_references": { "type": "array", "items": { "type": "object" } },
    "content_blocks": {
      "type": "array",
      "items": { "$ref": "content-block.schema.json" }
    },
    "visual_requirements": { "type": "array", "items": { "type": "object" } },
    "chart_requirements": { "type": "array", "items": { "type": "object" } },
    "image_requirements": { "type": "array", "items": { "type": "object" } },
    "layout_recommendation": { "type": "string" },
    "speaker_note_requirements": { "type": "object" },
    "transition_from_previous": { "type": "string" },
    "transition_to_next": { "type": "string" },
    "accessibility_notes": { "type": "array", "items": { "type": "string" } },
    "unsupported_or_missing_evidence": { "type": "array", "items": { "type": "string" } },
    "human_review_required": { "type": "boolean" },
    "provenance": { "type": "object" }
  },
  "required": [
    "slide_id", "sequence_number", "slide_type", "title", "purpose", "key_message",
    "supporting_points", "evidence_references", "content_blocks", "layout_recommendation",
    "speaker_note_requirements", "accessibility_notes", "human_review_required", "provenance"
  ]
}
