{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ms.skill.competitor_analysis/differentiation_gap/0.1.0",
  "title": "DifferentiationGap",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gap_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dimension": { "type": "string", "maxLength": 256 },
    "observed_pattern": { "type": "string", "maxLength": 2000 },
    "customer_relevance": { "type": "string", "maxLength": 2000 },
    "evidence_references": {
      "type": "array",
      "items": { "type": "string", "maxLength": 2000 },
      "maxItems": 30
    },
    "competitor_coverage": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "maxItems": 30
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 },
      "maxItems": 20
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 },
      "maxItems": 20
    },
    "validation_needed": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 },
      "maxItems": 20
    },
    "positioning_candidate_reference": {
      "type": "string",
      "maxLength": 500,
      "description": "Downstream hint for ms.skill.positioning — not a positioning statement."
    }
  },
  "required": [
    "gap_id",
    "dimension",
    "observed_pattern",
    "customer_relevance",
    "evidence_references",
    "confidence"
  ]
}
