{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ms.skill.competitor_analysis/output/0.1.0",
  "title": "CompetitorAnalysisSkillOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "analysis_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "skill_id": { "type": "string", "const": "ms.skill.competitor_analysis" },
    "skill_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "source_context_reference": { "$ref": "#/$defs/upstream_reference" },
    "source_research_reference": { "$ref": "#/$defs/upstream_reference" },
    "competitor_inventory": {
      "type": "array",
      "items": { "$ref": "schemas/competitor.schema.json" },
      "maxItems": 100
    },
    "competitor_type_summary": { "$ref": "#/$defs/type_summary" },
    "direct_competitors": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "maxItems": 50
    },
    "indirect_competitors": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "maxItems": 50
    },
    "substitutes": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "maxItems": 50
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "maxItems": 50
    },
    "emerging_competitors": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "maxItems": 50
    },
    "comparison_dimensions": {
      "type": "array",
      "items": { "$ref": "schemas/comparison_dimension.schema.json" },
      "maxItems": 50
    },
    "competitive_landscape": { "$ref": "#/$defs/competitive_landscape" },
    "market_pressure_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "audience_overlap_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "pricing_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/pricing_finding" },
      "maxItems": 50
    },
    "offer_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "channel_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "proof_and_trust_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "differentiation_gaps": {
      "type": "array",
      "items": { "$ref": "schemas/differentiation_gap.schema.json" },
      "maxItems": 50
    },
    "defensibility_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "unsupported_competitor_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "supporting_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 100
    },
    "contradictory_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "inferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_item" },
      "maxItems": 50
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown_item" },
      "maxItems": 50
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict_item" },
      "maxItems": 50
    },
    "evidence_gaps": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 },
      "maxItems": 50
    },
    "coverage": {
      "type": "string",
      "enum": ["full", "partial", "minimal", "unknown"]
    },
    "evidence_quality": {
      "type": "string",
      "enum": ["comprehensive", "partial", "insufficient", "conflicted", "unknown"]
    },
    "research_status": {
      "type": "string",
      "enum": [
        "complete",
        "partially_complete",
        "insufficient_sources",
        "conflicted",
        "out_of_scope"
      ]
    },
    "recommended_next_research": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 },
      "maxItems": 30
    },
    "downstream_consumer_notes": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 },
      "maxItems": 20
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "analysis_id",
    "skill_id",
    "skill_version",
    "source_context_reference",
    "source_research_reference",
    "competitor_inventory",
    "competitor_type_summary",
    "direct_competitors",
    "indirect_competitors",
    "substitutes",
    "alternatives",
    "emerging_competitors",
    "comparison_dimensions",
    "competitive_landscape",
    "market_pressure_findings",
    "audience_overlap_findings",
    "pricing_findings",
    "offer_findings",
    "channel_findings",
    "proof_and_trust_findings",
    "differentiation_gaps",
    "defensibility_findings",
    "unsupported_competitor_claims",
    "supporting_evidence",
    "contradictory_evidence",
    "assumptions",
    "inferences",
    "unknowns",
    "conflicts",
    "evidence_gaps",
    "coverage",
    "evidence_quality",
    "research_status",
    "recommended_next_research",
    "downstream_consumer_notes",
    "provenance",
    "input_hash",
    "output_hash"
  ],
  "$defs": {
    "upstream_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_skill_id": { "type": "string" },
        "source_skill_version": { "type": "string" },
        "source_output_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_evidence_references": {
          "type": "array",
          "items": { "type": "string", "maxLength": 2000 },
          "maxItems": 100
        },
        "source_unknowns": {
          "type": "array",
          "items": { "$ref": "#/$defs/unknown_item" },
          "maxItems": 50
        },
        "source_conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/conflict_item" },
          "maxItems": 50
        }
      },
      "required": ["source_skill_id", "source_skill_version", "source_output_hash"]
    },
    "type_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct": { "type": "integer", "minimum": 0 },
        "indirect": { "type": "integer", "minimum": 0 },
        "substitute": { "type": "integer", "minimum": 0 },
        "alternative": { "type": "integer", "minimum": 0 },
        "emerging": { "type": "integer", "minimum": 0 },
        "potential": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      },
      "required": ["direct", "indirect", "substitute", "alternative", "unknown"]
    },
    "competitive_landscape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category_structure": { "type": "string", "maxLength": 4000 },
        "crowded_vs_fragmented_signals": { "type": "string", "maxLength": 2000 },
        "concentration_observations": { "type": "string", "maxLength": 2000 },
        "direct_competition_pressure": { "type": "string", "maxLength": 2000 },
        "substitute_pressure": { "type": "string", "maxLength": 2000 },
        "switching_alternatives": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "maxItems": 30
        },
        "observed_positioning_clusters": {
          "type": "array",
          "items": { "type": "string", "maxLength": 1000 },
          "maxItems": 20
        },
        "pricing_clusters": {
          "type": "array",
          "items": { "type": "string", "maxLength": 1000 },
          "maxItems": 20
        },
        "channel_concentration": { "type": "string", "maxLength": 2000 },
        "evidence_gaps": {
          "type": "array",
          "items": { "type": "string", "maxLength": 1000 },
          "maxItems": 30
        },
        "unknown_competitor_classes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "maxItems": 20
        }
      },
      "required": [
        "category_structure",
        "direct_competition_pressure",
        "substitute_pressure",
        "evidence_gaps",
        "unknown_competitor_classes"
      ]
    },
    "finding_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": { "type": "string", "maxLength": 128 },
        "claim": { "type": "string", "maxLength": 4000 },
        "observation": { "type": "string", "maxLength": 4000 },
        "source_reference": { "type": "string", "maxLength": 2000 },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "partially_verified",
            "verified",
            "contradicted",
            "unknown"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "inference": { "type": "boolean", "default": false },
        "limitations": { "type": "string", "maxLength": 2000 }
      },
      "required": ["finding_id", "claim", "verification_status", "confidence"]
    },
    "pricing_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": { "type": "string", "maxLength": 128 },
        "claim": { "type": "string", "maxLength": 4000 },
        "competitor_id": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "observed_at": { "type": "string", "format": "date" },
        "source_reference": { "type": "string", "maxLength": 2000 },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "partially_verified",
            "verified",
            "contradicted",
            "unknown"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        }
      },
      "required": ["finding_id", "claim", "verification_status", "confidence"]
    },
    "unknown_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 2000 },
        "blocking": { "type": "boolean" }
      },
      "required": ["domain", "description"]
    },
    "conflict_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 2000 },
        "conflicting_claims": {
          "type": "array",
          "items": { "type": "string", "maxLength": 2000 },
          "maxItems": 10
        }
      },
      "required": ["domain", "description"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_id": { "type": "string" },
        "skill_version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "methodology_ref": { "type": "string" },
        "source_context_skill_id": { "type": "string" },
        "source_context_skill_version": { "type": "string" },
        "source_context_output_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_research_skill_id": { "type": "string" },
        "source_research_skill_version": { "type": "string" },
        "source_research_output_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["skill_id", "skill_version"]
    }
  }
}
