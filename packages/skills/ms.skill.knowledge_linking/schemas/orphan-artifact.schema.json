{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orphan-artifact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_id": { "type": "string" },
    "artifact_type": { "type": "string" },
    "orphan_reason": { "type": "string" },
    "expected_link_types": { "type": "array", "items": { "type": "string" } },
    "possible_targets": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string" },
    "human_review_required": { "type": "boolean" },
    "provenance": { "type": "object" }
  },
  "required": [
    "artifact_id", "artifact_type", "orphan_reason", "expected_link_types",
    "possible_targets", "confidence", "human_review_required", "provenance"
  ]
}
