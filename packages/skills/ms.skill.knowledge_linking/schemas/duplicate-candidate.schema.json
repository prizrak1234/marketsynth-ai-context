{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "duplicate-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "duplicate_candidate_id": { "type": "string" },
    "artifact_ids": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "duplicate_type": {
      "type": "string",
      "enum": [
        "exact_content", "identity_conflict", "version_conflict", "normalized_title",
        "topology_equivalent", "semantic_practice_overlap", "copied_source", "unknown"
      ]
    },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "differences": { "type": "array", "items": { "type": "object" } },
    "confidence": { "type": "string" },
    "merge_recommended": { "type": "boolean", "const": false },
    "human_review_required": { "type": "boolean" },
    "provenance": { "type": "object" }
  },
  "required": [
    "duplicate_candidate_id", "artifact_ids", "duplicate_type", "evidence",
    "differences", "confidence", "merge_recommended", "human_review_required", "provenance"
  ]
}
