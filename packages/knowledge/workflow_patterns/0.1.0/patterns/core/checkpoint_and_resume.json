{
  "pattern_id": "checkpoint_and_resume",
  "pattern_name": "Checkpoint and Resume",
  "pattern_category": "reliability",
  "objective": "Persist progress before expensive steps and resume safely.",
  "problem_context": "Media conversion and automation loops with wait segments.",
  "capability_ids": [
    "scheduling"
  ],
  "related_skill_ids": [
    "ms.skill.n8n_workflow_architecture"
  ],
  "input_contract": {
    "type": "object",
    "required": [
      "tenant_context",
      "correlation_id",
      "checkpoint_id"
    ]
  },
  "output_contract": {
    "type": "object",
    "required": [
      "status",
      "checkpoint_id",
      "evidence_refs"
    ]
  },
  "steps": [
    {
      "step_id": "s1",
      "step_name": "Load checkpoint",
      "step_type": "read",
      "security_class": "read_only"
    },
    {
      "step_id": "s2",
      "step_name": "Write checkpoint",
      "step_type": "write",
      "security_class": "write_internal"
    },
    {
      "step_id": "s3",
      "step_name": "Expensive operation",
      "step_type": "transform",
      "security_class": "elevated_review"
    },
    {
      "step_id": "s4",
      "step_name": "Mark complete",
      "step_type": "write",
      "security_class": "write_internal"
    }
  ],
  "edges": [
    {
      "edge_id": "e1",
      "from_step_id": "s1",
      "to_step_id": "s2"
    },
    {
      "edge_id": "e2",
      "from_step_id": "s2",
      "to_step_id": "s3"
    },
    {
      "edge_id": "e3",
      "from_step_id": "s3",
      "to_step_id": "s4",
      "condition": "success"
    },
    {
      "edge_id": "e4",
      "from_step_id": "s3",
      "to_step_id": "s1",
      "condition": "retry_from_checkpoint",
      "on_failure": "retry"
    }
  ],
  "required_connectors": [],
  "required_tools": [],
  "approval_requirements": {
    "human_approval_required": false,
