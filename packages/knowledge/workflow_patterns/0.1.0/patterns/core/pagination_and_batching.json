{
  "pattern_id": "pagination_and_batching",
  "pattern_name": "Pagination and Batching",
  "pattern_category": "data_flow",
  "objective": "Process large datasets via bounded pages and batches.",
  "problem_context": "Lead retargeting and scheduled enrichment over many records.",
  "capability_ids": [
    "scheduling",
    "lead_generation"
  ],
  "related_skill_ids": [
    "ms.skill.n8n_workflow_architecture"
  ],
  "input_contract": {
    "type": "object",
    "required": [
      "tenant_context",
      "correlation_id",
      "max_batch_size"
    ]
  },
  "output_contract": {
    "type": "object",
    "required": [
      "status",
      "evidence_refs"
    ]
  },
  "steps": [
    {
      "step_id": "s1",
      "step_name": "Init cursor",
      "step_type": "transform",
      "security_class": "read_only"
    },
    {
      "step_id": "s2",
      "step_name": "Fetch page",
      "step_type": "read",
      "security_class": "read_only"
    },
    {
      "step_id": "s3",
      "step_name": "Process batch",
      "step_type": "transform",
      "security_class": "read_only"
    },
    {
      "step_id": "s4",
      "step_name": "Check termination",
      "step_type": "branch",
      "security_class": "read_only"
    }
  ],
  "edges": [
    {
      "edge_id": "e1",
      "from_step_id": "s1",
      "to_step_id": "s2"
    },
    {
      "edge_id": "e2",
      "from_step_id": "s2",
      "to_step_id": "s3"
    },
    {
      "edge_id": "e3",
      "from_step_id": "s3",
      "to_step_id": "s4"
    },
    {
      "edge_id": "e4",
      "from_step_id": "s4",
      "to_step_id": "s2",
      "condition": "has_more"
    },
    {
      "edge_id": "e5",
      "from_step_id": "s4",
      "to_step_id": "s1",
      "condition": "complete"
    }
  ],
