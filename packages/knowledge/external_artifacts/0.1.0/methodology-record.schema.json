{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.marketsynth.ai/external-artifacts/0.1.0/methodology-record.schema.json",
  "title": "MethodologyRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "methodology_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "type": "string"
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "methodology_id",
    "title",
    "domain",
    "verification_status",
    "provenance"
  ]
}
