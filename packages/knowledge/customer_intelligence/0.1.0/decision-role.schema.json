{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.marketsynth.ai/customer-intelligence/0.1.0/decision-role.schema.json",
  "title": "DecisionRole",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "role_type": {
      "type": "string",
      "enum": [
        "user",
        "initiator",
        "influencer",
        "evaluator",
        "decision_maker",
        "buyer",
        "approver",
        "blocker",
        "administrator",
        "champion",
        "unknown"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 20
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 20
    },
    "influence_level": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "decision_authority": {
      "type": "string",
      "enum": [
        "final",
        "shared",
        "advisory",
        "none",
        "unknown"
      ]
    },
    "information_needs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 20
    },
    "objections": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.marketsynth.ai/customer-intelligence/0.1.0/customer-claim.schema.json"
      },
      "maxItems": 20
    },
    "trust_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 20
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 20
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 20
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 20
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "provenance": {
      "$ref": "https://schemas.marketsynth.ai/customer-intelligence/0.1.0/provenance.schema.json"
    }
  },
  "required": [
    "role_id",
    "role_type",
    "description",
    "confidence"
  ]
}
