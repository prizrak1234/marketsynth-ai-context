    {
      "parameters": {
        "jsCode": "// Получаем входные данные\nconst input = $input.first().json;\n\n// Извлекаем URL\nconst url = input.URL || input.url || null;\n\n// Извлекаем ID ролика из ссылки (например, DDE8cQntcjZ)\nfunction extractReelCode(u) {\n  if (!u) return null;\n  const m = String(u).match(/instagram\\.com\\/reel\\/([^/?#]+)/i);\n  return m ? m[1] : null;\n}\n\n// Формируем результат\nconst result = {\n  message: \"Транскрибация видео выполнена успешно\",\n  status: \"success\",\n  video_id: extractReelCode(url),\n  video_url: url,\n  transcript: input.transcript || \"\"\n};\n\nreturn [{ json: result }];\n"
      },
