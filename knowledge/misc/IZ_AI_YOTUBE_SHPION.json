    {
      "parameters": {
        "jsCode": "// Фильтруем видео: исключаем Shorts и показываем только за последние 24 часа\nconst filteredItems = items.filter(item => {\n  const link = item.json.link;\n  const videoDate = new Date(item.json.isoDate);\n  const now = new Date();\n  \n  // Вычисляем разницу во времени в часах\n  const hoursDifference = (now - videoDate) / (1000 * 60 * 60);\n  \n  // Исключаем Shorts (они содержат /shorts/ в ссылке)\n  const isNotShorts = !link.includes('/shorts/');\n  \n  // Проверяем, что видео загружено не позже 24 часов назад\n  const isWithin24Hours = hoursDifference <= 24;\n  \n  // Возвращаем true только если оба условия выполнены\n  return isNotShorts && isWithin24Hours;\n}).map(item => {\n  // Извлекаем ID видео из ссылки\n  const link = item.json.link;\n  let videoId = '';\n  \n  // Для обычных видео: https://www.youtube.com/watch?v=VIDEO_ID\n  const watchMatch = link.match(/[?&]v=([^&]+)/);\n  if (watchMatch) {\n    videoId = watchMatch[1];\n  }\n  \n  // Добавляем ID видео к объекту\n  return {\n    ...item,\n    json: {\n      ...item.json,\n      videoId: videoId\n    }\n  };\n});\n\n// Возвращаем отфильтрованные элементы с добавленным videoId\nreturn filteredItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        200
      ],
