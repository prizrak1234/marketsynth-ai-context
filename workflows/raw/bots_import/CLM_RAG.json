    {
      "parameters": {
        "jsCode": "const doc = $input.first().json;\n\nfunction formatOutput(output) {\n  if (typeof output === 'object') {\n    try {\n      return JSON.stringify(output, null, 2);\n    } catch (e) {\n      return '[Ошибка при сериализации output]';\n    }\n  }\n  return String(output || 'Без сообщения');\n}\n\nlet message = `<b>📄 ${formatOutput(doc.output)}</b>\\n\\n`;\n\nif (doc.contractName) {\n  message += `<b>Название:</b> ${doc.contractName}\\n`;\n}\n\nif (doc.publicURL) {\n  message += `<b>Ссылка:</b> <a href=\"${doc.publicURL}\">Открыть документ</a>\\n`;\n}\n\nif (doc.recipients && Array.isArray(doc.recipients) && doc.recipients.length > 0) {\n  message += `\\n👥 <b>Получатели:</b>\\n`;\n  doc.recipients.forEach((r, index) => {\n    const name = r.fullname || 'Без имени';\n    const email = r.email || 'Без email';\n    const link = r.recipientURL || '#';\n\n    message += `${index + 1}. <b>${name}</b> — ${email}\\n`;\n    message += `<a href=\"${link}\">🔗 Ссылка для подписания</a>\\n\\n`;\n  });\n}\n\nreturn [{ json: { message } }];\n"
      },
