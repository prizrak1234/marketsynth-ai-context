    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    string_agg(message, E'\\n\\n' ORDER BY created_at DESC) AS formatted_messages,\n    EXISTS (\n        SELECT 1 \n        FROM waitlist_users \n        WHERE chat_id = '{{ $('All the data').item.json.chat_id }}' \n        AND subscribed = TRUE\n    ) AS is_subscribed\nFROM (\n    SELECT message, created_at\n    FROM waitlist_users\n    WHERE chat_id = '{{ $('All the data').item.json.chat_id }}'\n    ORDER BY created_at DESC\n    LIMIT 10\n) subquery;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
