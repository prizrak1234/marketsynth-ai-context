    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const chunks = [];\nconst chunkSize = 400;\nconst chunkOverlap = 0;\nconst text = $json.text;\n\nfor (let i = 0; i < text.length; i += (chunkSize - chunkOverlap)) {\n  const chunk = text.substr(i, chunkSize);\n  if (chunk) {\n    chunks.push(chunk);\n  }\n}\n\nreturn { chunks };\n"
