    {
      "parameters": {
        "jsCode": "// Вход: данные из предыдущего шага\nconst data = items[0].json;\n\n// items может быть внутри массива (как у Google Custom Search)\nconst results = data.items || [];\n\nfunction extractName(title) {\n  if (!title) return null;\n  // Берём всё до первого \"–\" или \"-\"\n  return title.split(\"–\")[0].split(\"-\")[0].trim();\n}\n\nfunction extractRole(title) {\n  if (!title) return null;\n  // Берём всё после \"–\" или \"-\"\n  const parts = title.split(\"–\");\n  if (parts.length > 1) return parts[1].trim();\n  const dashParts = title.split(\"-\");\n  if (dashParts.length > 1) return dashParts[1].trim();\n  return null;\n}\n\nfunction extractLocation(snippet) {\n  if (!snippet) return null;\n  const match = snippet.match(/Berlin|Germany|Deutschland|New York|London|Paris/i);\n  return match ? match[0] : null;\n}\n\nfunction extractImage(pagemap) {\n  if (!pagemap) return null;\n  if (pagemap.cse_image && pagemap.cse_image[0]?.src) {\n    return pagemap.cse_image[0].src;\n  }\n  if (pagemap.metatags && pagemap.metatags[0]?.[\"og:image\"]) {\n    return pagemap.metatags[0][\"og:image\"];\n  }\n  return null;\n}\n\nconst output = results.map(r => ({\n  name: extractName(r.title),\n  role: extractRole(r.title),\n  link: r.link,\n  snippet: r.snippet,\n  image: extractImage(r.pagemap),\n  location: extractLocation(r.snippet),\n  displayLink: r.displayLink,\n  rawTitle: r.title,\n}));\n\nreturn output.map(o => ({ json: o }));\n"
      },
