{
  "name": "Админ-бот: Административный бот",
  "flow": [
    {
      "id": 1,
      "module": "telegram:watchUpdates",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {}
      }
    },
    {
      "id": 2,
      "module": "airtable:searchRecords",
      "version": 3,
      "parameters": {},
      "mapper": {
        "base": "{{connection.base}}",
        "table": "Salons",
        "formula": "{admin_telegram_id} = {{1.message.from.id}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {}
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "routes": [
        {
          "label": "Авторизованный админ",
          "expression": "{{length(2.records)}} > 0"
        },
        {
          "label": "Неавторизованный пользователь",
          "expression": "{{length(2.records)}} = 0"
        }
      ],
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {}
      }
    },
    {
      "id": 4,
      "module": "telegram:sendMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "chatId": "{{1.message.chat.id}}",
        "text": "❌ **Доступ запрещён**\n\nВы не являетесь администратором салона.\nДля получения доступа обратитесь к владельцу системы.",
        "parseMode": "Markdown"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": -200
        },
        "restore": {}
      }
    },
    {
      "id": 5,
      "module": "builtin:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "salon_id",
            "value": "{{2.records[0].id}}"
          },
          {
            "name": "salon_name",
            "value": "{{2.records[0].name}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 100
        },
        "restore": {}
      }
    },
    {
      "id": 6,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "routes": [
        {
          "label": "Команда /start",
          "expression": "{{1.message.text}} = \"/start\""
        },
        {
          "label": "Команда /today",
          "expression": "{{1.message.text}} = \"/today\""
        },
        {
          "label": "Команда /bookings",
          "expression": "{{1.message.text}} = \"/bookings\""
        },
        {
          "label": "Команда /masters",
          "expression": "{{1.message.text}} = \"/masters\""
        },
        {
          "label": "Команда /services",
          "expression": "{{1.message.text}} = \"/services\""
        },
        {
          "label": "Команда /analytics",
          "expression": "{{1.message.text}} = \"/analytics\""
        },
        {
          "label": "Callback Query",
          "expression": "{{1.callback_query}} exists"
        }
      ],
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 100
        },
        "restore": {}
      }
    },
    {
      "id": 7,
      "module": "telegram:sendMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "chatId": "{{1.message.chat.id}}",
        "text": "👨‍💼 **Админ-панель салона \"{{5.salon_name}}\"**\n\n🎯 **Основные команды:**\n/today - Записи на сегодня\n/bookings - Все записи\n/masters - Управление мастерами\n/services - Управление услугами\n/analytics - Статистика и аналитика\n\n📊 **Быстрый доступ:**",
        "parseMode": "Markdown",
        "replyMarkup": {
          "inlineKeyboard": [
            [
              {
                "text": "📅 Сегодня",
                "callbackData": "show_today"
              },
              {
                "text": "📋 Все записи",
                "callbackData": "show_bookings"
              }
            ],
            [
              {
                "text": "👨‍💼 Мастера",
                "callbackData": "manage_masters"
              },
              {
                "text": "💇‍♀️ Услуги",
                "callbackData": "manage_services"
              }
            ],
            [
              {
                "text": "📊 Аналитика",
                "callbackData": "show_analytics"
              }
            ]
          ]
        }
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": -200
        },
        "restore": {}
      }
    },
    {
      "id": 8,
      "module": "airtable:searchRecords",
      "version": 3,
      "parameters": {},
      "mapper": {
        "base": "{{connection.base}}",
        "table": "Bookings",
        "formula": "AND({salon_id} = '{{5.salon_id}}', IS_SAME({booking_date}, TODAY(), 'day'), {status} != 'cancelled')",
        "sort": [
          {
            "field": "booking_date",
            "direction": "asc"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": -100
        },
        "restore": {}
      }
    },
    {
      "id": 9,
      "module": "builtin:BasicAggregator",
      "version": 1,
      "parameters": {
        "feeder": 8
      },
      "mapper": {
        "aggregateFunction": "text",
        "text": "🕐 {{formatDate(8.booking_date, \"HH:mm\")}} - {{8.client_name}}\n💇‍♀️ {{8.service_name}} ({{8.master_name}})\n📱 {{8.client_phone}}\n💰 {{8.price}}₽ | 📍 {{8.status}}\n\n"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": -100
        },
        "restore": {}
      }
    },
    {
      "id": 10,
      "module": "builtin:BasicMath",
      "version": 1,
      "parameters": {},
      "mapper": {
        "operator": "sum",
        "operands": "{{map(8.records, price)}}"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": -100
        },
        "restore": {}
      }
    },
    {
      "id": 11,
      "module": "telegram:sendMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "chatId": "{{coalesce(1.message.chat.id, 1.callback_query.message.chat.id)}}",
        "text": "📅 **Записи на сегодня ({{formatDate(now, \"DD.MM.YYYY\")}}):**\n\n{{if(length(8.records) > 0, 9.text, \"📭 На сегодня записей нет.\")}}\n\n📊 **Итого:** {{length(8.records)}} записей на {{10.result}}₽",
        "parseMode": "Markdown",
        "replyMarkup": {
          "inlineKeyboard": [
            [
              {
                "text": "📋 Все записи",
                "callbackData": "show_bookings"
              },
              {
                "text": "🔄 Обновить",
                "callbackData": "show_today"
              }
            ]
          ]
        }
      },
      "metadata": {
        "designer": {
          "x": 2400,
          "y": -100
        },
        "restore": {}
      }
    },
    {
      "id": 12,
      "module": "airtable:searchRecords",
      "version": 3,
      "parameters": {},
      "mapper": {
        "base": "{{connection.base}}",
        "table": "Bookings",
        "formula": "AND({salon_id} = '{{5.salon_id}}', {booking_date} >= DATEADD(TODAY(), -7, 'days'))",
        "sort": [
          {
            "field": "booking_date",
            "direction": "desc"
          }
        ],
        "limit": 20
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        },
        "restore": {}
