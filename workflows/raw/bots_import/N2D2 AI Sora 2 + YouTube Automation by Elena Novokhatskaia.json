    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  try {\n    // 1. Достаем строку resultJson из объекта data\n    const rawJsonString = item.json.data.resultJson;\n\n    // 2. Парсим эту строку в объект\n    const parsedData = JSON.parse(rawJsonString);\n\n    // 3. Берем первую ссылку из массива resultUrls\n    // и сохраняем её в новое поле videoUrl для удобства\n    item.json.videoUrl = parsedData.resultUrls[0];\n    \n  } catch (error) {\n    // Если что-то пошло не так (например, пустой ответ), пишем ошибку\n    item.json.videoUrl = null;\n    item.json.error = \"Не удалось найти или распарсить ссылку: \" + error.message;\n  }\n}\n\nreturn $input.all();"
      },
