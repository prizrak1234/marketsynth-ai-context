    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: Professional Cinematographer and Sora 2 Prompt Engineer.\n\nTask: Expand the input \"{{ $json.randomPrompt }}\" into a highly detailed, cinematic video generation prompt.\n\nConstraint: 1. DO NOT include any conversational filler, introductory remarks, or phrases like \"Here is your prompt.\" 2. Output ONLY the expanded description following the template below. 3. Language: English.\n\nTemplate to follow (Strictly): [Detailed and vivid description of the scene, style, and atmosphere, integrating the cameo of @MYCAMEO as a main character]. Shot: [plan and angle]. Mood: [tonality]. Actions: [specific action 1]. [specific action 2]. Dialogue: [Only if applicable].",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1056,
        544
      ],
      "id": "60a9a2f8-9c92-43a8-9a44-ff94ea5d47ff",
      "name": "Prompt Agent"
    },
    {
      "parameters": {
        "jsCode": "// Списки слов для генерации\nconst actions = [\n  \"skydiving\", \"swimming\", \"dancing\", \"riding a bike\", \"cooking\", \n  \"playing guitar\", \"skating\", \"running\", \"meditating\", \"fighting\"\n];\n\nconst subjects = [\n  \"with a dog\", \"with a majestic dragon\", \"as a golden retriever\", \n  \"with a futuristic robot\", \"as a cyberpunk samurai\", \"with a group of penguins\",\n  \"as a giant marshmallow man\", \"with a tiny hamster\"\n];\n\nconst settings = [\n  \"in the minecraft world\", \"on the surface of Mars\", \"underwater in a coral reef\",\n  \"in a neon-lit Tokyo alley\", \"inside a floating castle\", \"in a forest made of candy\",\n  \"at a disco in the 70s\", \"in a cinematic studio Ghibli landscape\"\n];\n\n// Функция для получения случайного элемента\nconst getRandom = (arr) => arr[Math.floor(Math.random() * arr.length)];\n\n// Генерация финального промпта\nconst randomPrompt = `${getRandom(actions)} ${getRandom(subjects)} ${getRandom(settings)}`;\n\n// Возвращаем результат в формате n8n\nreturn {\n  randomPrompt,\n  generated_at: new Date().toISOString()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
