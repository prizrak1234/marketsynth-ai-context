    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.output || \"\";\n\n\n\nconst cleanedPrompt = rawText\n\n  .replace(/\\*\\*/g, '')   \n\n  .replace(/\\*/g, '')  \n\n  .replace(/\\n+/g, ' ') \n\n  .replace(/\\\\/g, '')  \n\n  .replace(/\\s+/g, ' ')\n  .replace(/\\\"/g, ' ')\n\n  .trim();                   \n\n\n\nreturn {\n\n  prompt: cleanedPrompt\n\n}"
      },
