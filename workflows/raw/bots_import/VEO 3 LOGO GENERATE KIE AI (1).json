        "jsCode": "// Обработка идеального ответа агента\nconst rawOutput = $input.first().json.output;\n\ntry {\n  // Парсим основной JSON\n  const parsed = JSON.parse(rawOutput);\n  \n  // Проверяем что все нужные поля есть\n  if (!parsed.aspect_ratio || !parsed.video_model || !parsed.full_video_prompt) {\n    throw new Error('Missing required fields');\n  }\n  \n  // Возвращаем готовый результат\n  return [{\n    json: {\n      aspect_ratio: parsed.aspect_ratio,\n      video_model: parsed.video_model, \n      full_video_prompt: parsed.full_video_prompt\n    }\n  }];\n  \n} catch (error) {\n  // В случае ошибки показываем подробности\n  throw new Error(`Parse error: ${error.message}. Raw: ${rawOutput.substring(0, 200)}...`);\n}"
