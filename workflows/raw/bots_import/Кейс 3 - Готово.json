      "parameters": {
        "method": "POST",
        "url": "https://api.polza.ai/api/v1/audio/speech",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer pza_1PbRGzhctl-83UG22JYPB_m9-523b3yg"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"elevenlabs/text-to-speech-multilingual-v2\",\n  \"input\": $json.output,\n  \"similarity_boost\": 0.75,\n  \"speed\": 1,\n  \"stability\": 0.5,\n  \"style\": 0.5,\n  \"timestamps\": false,\n  \"voice\": \"Sarah\"\n} }}",
