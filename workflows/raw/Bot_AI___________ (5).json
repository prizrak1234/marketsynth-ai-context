        "jsCode": "const months = [\n  'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',\n  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'\n];\n\nconst now = new Date();\nnow.setDate(now.getDate() - 1);\nconst day = now.getDate();\nconst month = months[now.getMonth()];\nconst formatted = `${day} ${month}`;\n\nreturn [{\n  json: {\n    ...items[0].json,\n    yesterday: formatted\n  }\n}];"
      },
