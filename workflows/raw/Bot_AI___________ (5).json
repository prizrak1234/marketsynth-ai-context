    {
      "parameters": {
        "jsCode": "const chunkSize = 300;\nconst results = [];\n\nfor (const item of items) {\n  const text = item.json.text;\n  const text_reply = item.json.text_reply;\n\n  // Формируем итоговый контент: если есть text_reply, он добавляется первым, потом основной текст\n  let fullText = \"\";\n  if (text_reply && typeof text_reply === \"string\" && text_reply.trim().length > 0) {\n    fullText = `${text_reply}\\n${text}`;\n  } else {\n    fullText = text;\n  }\n\n  // Пропускаем пустые строки\n  if (!fullText || typeof fullText !== 'string' || fullText.trim().length === 0) continue;\n\n  // Режем на чанки если нужно\n  for (let i = 0; i < fullText.length; i += chunkSize) {\n    const chunk = fullText.slice(i, i + chunkSize).trim();\n    if (chunk.length === 0) continue;\n\n    results.push({\n      json: {\n        content: chunk,\n        metadata: {\n          username: item.json.username,\n          message_id: item.json.message_id,\n          message_thread_id: item.json.message_thread_id,\n          created_at: item.json.created_at\n        }\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
