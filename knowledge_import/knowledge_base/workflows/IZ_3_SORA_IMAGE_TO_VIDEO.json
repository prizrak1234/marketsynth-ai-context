    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items  (подойдет и Run Once for Each Item)\n// Language: JavaScript\n\nfunction slugify(s) {\n  return (s ?? \"\")\n    .toString()\n    .toLowerCase()\n    .normalize('NFKD').replace(/[\\u0300-\\u036f]/g, '') // убрать диакритику\n    .replace(/[^a-z0-9]+/g, '-')                       // не буквы/цифры → \"-\"\n    .replace(/^-+|-+$/g, '')                           // края\n    .replace(/-{2,}/g, '-')                            // двойные дефисы\n    .slice(0, 60);                                     // ограничение\n}\n\n// 1) Достаём URL из входа (и/или из resultJson)\nlet url = $json.video_url;\nif (!url) {\n  try {\n    const rj = $json.data?.resultJson;\n    const parsed = typeof rj === 'string' ? JSON.parse(rj) : rj;\n    url = parsed?.resultUrl?.[0] ?? parsed?.resultURL?.[0];\n  } catch (e) {}\n}\nif (!url) {\n  throw new Error('video_url not provided');\n}\n\n// 2) Парсим путь и расширение БЕЗ класса URL\nconst noHash = url.split('#')[0];\nconst pathOnly = noHash.split('?')[0];\nconst last = decodeURIComponent((pathOnly.split('/').pop() || 'video'));\nconst dotIdx = last.lastIndexOf('.');\nlet ext = 'mp4';\nlet stemFromUrl = last;\n\nif (dotIdx > -1 && dotIdx < last.length - 1) {\n  const cand = last.slice(dotIdx + 1).toLowerCase();\n  if (cand.length > 0 && cand.length <= 5) {\n    ext = cand;\n  }\n  stemFromUrl = last.slice(0, dotIdx);\n}\n\n// 3) Подсказка для имени (если есть)\nconst hint =\n  $json.base_name ||\n  $json.prompt ||\n  $json.title ||\n  $json.character ||\n  stemFromUrl;\n\n// 4) Уникальность\nconst now = new Date();\nconst stamp = now.toISOString().replace(/[-:.TZ]/g, '').slice(0, 14); // YYYYMMDDHHMMSS\nconst rand = Math.random().toString(36).slice(2, 8);\n\n// 5) Финальные имена\nconst nameCore = slugify(hint) || 'sora-video';\nconst file_stem = `${nameCore}-${stamp}-${rand}`;\nconst file_name = `${file_stem}.${ext}`;\n\n// 6) Путь по дате\nconst ymd = stamp.slice(0, 8); // YYYYMMDD\nconst remote_path = `sora/${ymd}/${file_name}`;\n\n// 7) Возврат в формате n8n items\nreturn [{\n  json: {\n    video_url: url,\n    file_name,\n    file_stem,\n    file_ext: ext,\n    remote_path\n  }\n}];\n"
      },
