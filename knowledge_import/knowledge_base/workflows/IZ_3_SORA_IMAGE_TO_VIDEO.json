    {
      "parameters": {
        "jsCode": "// 1) Берём готовый абсолютный URL из шита, если он есть\nlet videoUrl = ($json.URL || '').toString().trim();\n\n// 2) Если абсолютной ссылки нет — собираем из remote_path\nif (!/^https?:\\/\\//i.test(videoUrl)) {\n  const BASE_URL = 'https://izn8nfiles.com/n8n/';\n  const remotePath = ($json.remote_path || $json.video_url || '').toString().replace(/^\\/+/, '');\n  videoUrl = BASE_URL + remotePath;\n}\n\n// 3) Одно короткое сообщение для агента/бота\nreturn [{\n  json: {\n    message: `✅ Видео успешно сгенерировано: ${videoUrl}`,\n    video_url: videoUrl // (на всякий случай вторым полем)\n  }\n}];\n"
      },
