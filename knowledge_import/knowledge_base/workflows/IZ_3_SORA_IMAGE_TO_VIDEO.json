    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  // Берём расширение файла (если Telegram отдал)\n  const ext = item.json.fileExtension || item.binary?.data?.fileExtension || 'jpg';\n\n  let mime = 'application/octet-stream'; // значение по умолчанию\n\n  if (['jpg', 'jpeg'].includes(ext.toLowerCase())) mime = 'image/jpeg';\n  if (ext.toLowerCase() === 'png') mime = 'image/png';\n  if (ext.toLowerCase() === 'gif') mime = 'image/gif';\n  if (ext.toLowerCase() === 'webp') mime = 'image/webp';\n  if (ext.toLowerCase() === 'heic') mime = 'image/heic';\n\n  // Название файла (если нет — ставим дефолт)\n  const fileName = item.json.fileName || item.binary?.data?.fileName || `file.${ext}`;\n\n  // Добавляем новые поля в JSON\n  item.json.mimeType = mime;\n  item.json.fileName = fileName;\n\n  return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
