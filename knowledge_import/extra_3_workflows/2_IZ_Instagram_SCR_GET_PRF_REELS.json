    {
      "parameters": {
        "jsCode": "// === Code node (Run Once for All Items) ===\n\n// 1) Собираем строки\nconst rows = items.map(i => i.json);\n\n// 2) Утилиты\nconst toNum = v => Number(v) || 0;\nconst cut = (s, words = 12) => String(s || '')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .split(' ')\n  .slice(0, words)\n  .join(' ');\n\n// Фолбэки по подписи\nfunction pickCaption(r) {\n  return (r?.caption?.text) || r?.text || '';\n}\n\n// Ссылка на рил\nfunction buildUrl(r) {\n  if (r.url) return r.url;\n  if (r.code) return `https://www.instagram.com/reel/${r.code}/`;\n  return null;\n}\n\n// 3) Нормализация\nlet normalized = rows.map(r => {\n  const play = toNum(r.play_count || r.ig_play_count);       // \n  const like = toNum(r.like_count);                           // \n  const comm = toNum(r.comment_count);                        // \n\n  const er = play > 0 ? ((like + comm) / play) * 100 : 0;\n\n  const obj = {\n    url: buildUrl(r),\n    taken_at: r.taken_at ? new Date(Number(r.taken_at) * 1000).toISOString() : null, // \n    play, like, comm,\n    er: Number(er.toFixed(2)),\n    caption: pickCaption(r),\n    caption_short: cut(pickCaption(r), 12),\n  };\n\n  // Удаляем поля-пустышки\n  Object.keys(obj).forEach(k => {\n    if (obj[k] === null || obj[k] === '' || obj[k] === undefined) delete obj[k];\n  });\n\n  return obj;\n});\n\n// 4) Сортировка: просмотры ↓, затем комменты ↓, затем лайки ↓\nnormalized.sort((a, b) =>\n  (b.play - a.play) || (b.comm - a.comm) || (b.like - a.like)\n);\n\n// 5) Топ-3 + ранги\nconst top3 = normalized.slice(0, 3).map((x, i) => ({ rank: i + 1, ...x }));\n\n// 6) Профиль (из первых строк)\nfunction inferProfile(rows) {\n  const r0 = rows[0] || {};\n  const u = r0.user || r0.owner || {};\n  const username = u.username || r0.username || null;         // \n  const fullName = u.full_name || r0.full_name || null;       // \n  return {\n    username: username ? `@${String(username).replace(/^@/, '')}` : null,\n    nickname: fullName || null,\n  };\n}\n\nconst profile = inferProfile(rows);\n\nreturn [{ json: { profile, total: rows.length, top3 } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -64
      ],
      "id": "cfba6990-45f8-444f-903a-77e113f0f03d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Получаем данные из входящего item\nconst inputData = $input.all()[0].json;\n\n// Извлекаем username\nconst username = inputData.profile.username;\n\n// Извлекаем ссылки из top3 (Instagram Reels)\nconst videoLinks = inputData.top3.map(video => video.url);\n\n// Формируем результирующий JSON\nconst result = {\n  message: `Анализ контента пользователя ${username} выполнен успешно`,\n  username: username,\n  top_reels: {\n    description: \"3 самых популярных Reels пользователя\",\n    links: videoLinks\n  }\n};\n\nreturn result;\n"
      },
