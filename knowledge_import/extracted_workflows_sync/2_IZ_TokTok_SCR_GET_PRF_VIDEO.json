    {
      "parameters": {
        "jsCode": "// Собираем строки из таблицы\nconst rows = items.map(i => i.json);\n\n// Хелпер: вытащить @handle из URL\nfunction extractHandleFromUrl(url) {\n  if (!url) return null;\n  const m = String(url).match(/tiktok\\.com\\/@([^/]+)/i);\n  return m ? m[1] : null;\n}\n\n// Нормализуем поля и считаем ER\nconst normalized = rows.map(r => {\n  const play  = Number(r.play_count)    || 0;\n  const like  = Number(r.digg_count)    || 0;\n  const comm  = Number(r.comment_count) || 0;\n  const share = Number(r.share_count)   || 0;\n  const coll  = Number(r.collect_count) || 0;\n  const er = play > 0 ? ((like + comm + share) / play) * 100 : 0;\n\n  return {\n    // важно: ссылка на видео\n    link: r.URL || r.link || r.url || null,\n    desc: r.Desk || r.desc || \"\",\n    duration_ms: Number(r.duration_ms) || Number(r.duration) || null,\n    play, like, comm, share, collect: coll,\n    created_at: r.createdAt || r.created_at || r.publish_time || null,\n    er: Number(er.toFixed(2)) // в %\n  };\n});\n\n// Сортировка: по просмотрам ↓, затем по лайкам ↓, затем по репостам ↓\nnormalized.sort((a, b) =>\n  (b.play - a.play) || (b.like - a.like) || (b.share - a.share)\n);\n\n// Топ-3\nconst top3 = normalized.slice(0, 3);\n\n// Единая информация о профиле (берём из первой строки, если есть)\nconst first = rows[0] || {};\nconst inferredHandle =\n  first.username ||\n  first.unique_id ||\n  extractHandleFromUrl(first.URL) ||\n  extractHandleFromUrl(first.link) ||\n  $json.username || null;\n\nconst profile = {\n  username: inferredHandle ? `@${inferredHandle.replace(/^@/, '')}` : null,\n  nickname: first.nickname || null\n};\n\n// Итоговый ответ одним объектом\nreturn [{\n  json: {\n    profile,\n    total: rows.length,\n    top3\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -64
      ],
      "id": "bc8f44ff-dbfb-432f-83c6-a6018757dca9",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Получаем данные из входящего item\nconst inputData = $input.all()[0].json;\n\n// Извлекаем username\nconst username = inputData.profile.username;\n\n// Извлекаем ссылки из top3\nconst videoLinks = inputData.top3.map(video => video.link);\n\n// Формируем результирующий JSON\nconst result = {\n  message: `Анализ контента пользователя ${username} выполнен успешно`,\n  username: username,\n  top_videos: {\n    description: \"3 самых популярных видео пользователя\",\n    links: videoLinks\n  }\n};\n\nreturn result;"
      },
