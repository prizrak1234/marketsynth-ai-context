      "parameters": {
        "jsCode": "// === Threads: Ответ для ИИ-агента (пост проанализирован) ===\n\n// 1) Получаем входящие данные\nconst input = $input.all()[0].json;\n\n// 2) Достаём нужные поля\nconst username = input.username || \"неизвестный пользователь\";\nconst url = input.URL || `https://www.threads.net/@${username}/post/${input.post_id}`;\nconst postId = input.post_id || null;\n\n// 3) Формируем итоговое сообщение\nconst result = {\n  status: \"ok\",\n  message: `Пост пользователя ${username} проанализирован ✅`,\n  username: username,\n  post_id: postId,\n  url: url,\n  analyzed_at: new Date().toISOString()\n};\n\n// 4) Возвращаем один объект\nreturn [{ json: result }];\n"
