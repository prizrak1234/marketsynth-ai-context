# Runtime artifacts
data/generated_visuals/
data/reference_visuals/
data/_tmp_*
scripts/_tmp_*
scripts/_import_*
scripts/_probe_*
web/playwright-report/
web/test-results/
web/e2e-artifacts/
.tmp_*/
