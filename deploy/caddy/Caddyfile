# CPH.5 — OPTION B reverse proxy sketch (Caddy)
# Terminate TLS at the edge; frontend :3000 and API :8000 stay local HTTP.
# Generate certs with mkcert or use Caddy local CA.
#
# Example:
#   mkcert -install
#   mkcert pilot.localhost
#   caddy run --config deploy/caddy/Caddyfile

pilot.localhost {
	tls ./pilot.localhost.pem ./pilot.localhost-key.pem

	# Prefer same-origin: UI at /, API under /api/*
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
